# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
#
# Any OpenAI-compatible endpoint works (OpenRouter, OpenAI, Groq, local Ollama…).
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=openai/gpt-4o-mini
VITE_VISION_MODEL=openai/gpt-4o-mini
# Set to true to read receipts with the vision model by default.
VITE_AI_READING=false
