  "receipt_damage_conditions": [
    "clean",
    "lightly_crinkled",
    "heavily_crinkled",
    "folded",
    "multiple_folds",
    "wrinkled",
    "faded_ink",
    "thermal_paper_fading",
    "water_stains",
    "oil_stains",
    "torn_edges",
    "missing_corners",
    "partially_torn",
    "blurred",
    "shadowed",
    "low_light",
    "overexposed",
    "rotated",
    "curved_paper",
    "overlapping_objects",
    "handwritten_marks"
  ],
  "merchant_detection": {
    "enabled": true,
    "primary_detection_zone": "top_of_receipt",
    "search_strategy": {
      "priority_order": [
        "top_header",
        "upper_section",
        "middle_section",
        "bottom_section",
        "entire_receipt"
      ],
      "analyze_first_25_percent": true,
      "detect_largest_text": true,
      "detect_centered_text": true,
      "detect_bold_text": true,
      "detect_logo": true,
      "detect_stylized_names": true,
      "detect_faded_names": true,
      "detect_partial_names": true,
      "search_entire_receipt_if_missing": true
    },
    "header_analysis": {
      "detect_store_name": true,
      "detect_logo_and_branding": true,
      "detect_address": true,
      "detect_phone_number": true,
      "distinguish_store_name_from_slogan": true,
      "distinguish_store_name_from_address": true
    },
    "fallback_rules": {
      "if_top_missing": "search_remaining_receipt",
      "if_logo_only": "analyze_logo_and_text",
      "if_multiple_names": "compare_branding_and_context",
      "if_unreadable": "mark_merchant_unknown",
      "never_guess": true
    },
    "learning": {
      "learn_header_position_per_store": true,
      "learn_logo_position_per_store": true,
      "learn_font_patterns": true,
      "update_layout_after_new_examples": true
    }
  },
  "fields_to_extract": [
    "merchant_name",
    "merchant_address",
    "phone_number",
    "receipt_number",
    "transaction_id",
    "date",
    "time",
    "cashier",
    "register_number",
    "items",
    "item_quantities",
    "item_prices",
    "discounts",
    "coupons",
    "subtotal",
    "tax",
    "tip",
    "service_charge",
    "total",
    "payment_method",
    "card_last_four",
    "change",
    "currency"
  ],
  "adaptive_learning_system": {
    "enabled": true,
    "learning_mode": "continuous",
    "learning_status": {
      "states": [
        "not_started",
        "analyzing",
        "new_store_detected",
        "learning_layout",
        "learning_format",
        "testing_recognition",
        "learning_complete",
        "needs_more_examples",
        "low_confidence",
        "failed"
      ],
      "current_status": "not_started",
      "display_progress": true,
      "display_confidence": true,
      "display_learned_stores": true,
      "display_new_stores": true,
      "display_learning_history": true
    },
    "unknown_store_detection": {
      "enabled": true,
      "detect_unrecognized_merchant": true,
      "analyze_logo": true,
      "analyze_receipt_layout": true,
      "analyze_fonts": true,
      "analyze_printing_style": true,
      "analyze_item_format": true,
      "analyze_price_format": true,
      "analyze_tax_format": true,
      "analyze_currency": true
    },
    "learning_process": [
      "receive_receipt",
      "analyze_receipt",
      "identify_store",
      "detect_new_store",
      "create_provisional_profile",
      "learn_layout",
      "learn_formatting",
      "test_recognition",
      "verify_results",
      "save_learning"
    ],
    "learning_requirements": {
      "minimum_examples": 3,
      "recommended_examples": 10,
      "minimum_confidence": 0.85,
      "verify_multiple_receipts": true,
      "avoid_learning_from_one_bad_image": true,
      "detect_conflicting_patterns": true
    },
    "store_memory": {
      "enabled": true,
      "save_merchant_name": true,
      "save_logo_features": true,
      "save_receipt_layout": true,
      "save_common_item_formats": true,
      "save_currency_format": true,
      "save_tax_format": true,
      "save_date_format": true,
      "save_recognition_patterns": true,
      "save_uncertainties": true,
      "require_permission_for_persistent_learning": true
    },
    "store_database": {
      "known_stores": [],
      "new_stores": [],
      "provisional_stores": [],
      "learned_layouts": [],
      "last_learning_session": null
    },
    "retraining": {
      "enabled": true,
      "learn_from_user_corrections": true,
      "compare_predictions_with_corrected_text": true,
      "update_store_profiles": true,
      "preserve_previous_versions": true,
      "rollback_bad_learning": true
    }
  },
  "confidence_system": {
    "merchant_confidence": 0.0,
    "text_confidence": 0.0,
    "item_confidence": 0.0,
    "price_confidence": 0.0,
    "total_confidence": 0.0,
    "overall_confidence": 0.0,
    "report_confidence_per_field": true,
    "never_fake_confidence": true
  },
  "recognition_rules": {
    "preserve_original_text": true,
    "correct_obvious_ocr_errors": true,
    "never_invent_missing_text": true,
    "mark_uncertain_characters": true,
    "recognize_multiple_receipt_layouts": true,
    "recognize_thermal_printing": true,
    "recognize_handwriting": true,
    "detect_receipt_boundaries": true,
    "distinguish_item_prices_from_total": true,
    "detect_currency_symbols": true,
    "never_guess_card_numbers": true,
    "search_top_before_scanning_entire_receipt": true
  },
  "output_schema": {
    "merchant_name": null,
    "merchant_category": null,
    "merchant_confidence": 0.0,
    "date": null,
    "time": null,
    "currency": null,
    "items": [
      {
        "name": null,
        "quantity": null,
        "unit_price": null,
        "total_price": null,
        "confidence": 0.0
      }
    ],
    "subtotal": null,
    "discount": null,
    "tax": null,
    "tip": null,
    "total": null,
    "payment_method": null,
    "uncertain_text": [],
    "missing_fields": [],
    "overall_confidence": 0.0
  },
  "safety": {
    "never_invent_receipt_information": true,
    "never_assume_unknown_store_identity": true,
    "never_save_full_payment_card_numbers": true,
    "protect_personal_information": true,
    "request_permission_before_saving_receipt_images": true
  },
  "training_data_requirements": {
    "require_real_or_synthetic_receipt_images": true,
    "require_ground_truth_transcriptions": true,
    "include_damaged_receipt_examples": true,
    "include_unknown_store_examples": true,
    "include_multiple_receipt_layouts": true,
    "include_restaurant_tips_and_taxes": true,
    "include_different_currencies": true,
    "separate_training_and_validation_data": true
  }
}