# Lumen backend — copy to .env and fill in.
# Loaded automatically by the dev script if you run with `--env-file`, or export
# these in your shell / host dashboard.

# Port the API listens on.
PORT=8787
HOST=0.0.0.0

# OpenAI-compatible endpoint. The API key stays on the server.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Where receipts are stored (JSON file).
DATA_FILE=./data/receipts.json

# Browser origins allowed to call this API. '*' allows any (fine for a public
# demo); set to your site, e.g. https://vortexmc0606-hub.github.io
CORS_ORIGIN=*

# Optional shared secret. When set, clients must send it as the x-app-key header.
APP_KEY=
