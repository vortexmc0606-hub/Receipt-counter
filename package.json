{
  "name": "receipt-scanner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 12000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 12000",
    "typecheck": "tsc -b --noEmit",
    "dev:server": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "typecheck:server": "npm --prefix server run typecheck",
    "install:server": "npm --prefix server install",
    "gen:stores": "node scripts/generate-store-catalog.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
